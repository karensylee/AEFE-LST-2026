# Python
__pycache__/
*.py[cod]
*$py.class

# Environment
.env
.venv
.venv-backup/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
.memory/

# Data - ignore contents but keep directory structure
datasets/raw/**
datasets/processed/**
datasets/other/**
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/other/.gitkeep

# Data formats (except stations CSVs)
*.csv
!datasets/stations/*.csv
*.nc
*.h5
*.joblib
*.pkl

# Output directories
models/**
!models/.gitkeep
figures/**
!figures/.gitkeep
logs/**
!logs/.gitkeep
temp_predictions/**
!temp_predictions/.gitkeep

# Secrets
*token*
*secret*
*key*

# Markdown files
*.md
!README.md

# Keeping structure but ignoring content
# (Optional: use .gitkeep in folders if we want to track them)
